{
  "name": "obsidian-html-viewer",
  "version": "1.0.5",
  "description": "Obsidian plugin to render HTML files with local relative CSS, assets, and markdown link navigation.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs inline",
    "build": "node esbuild.config.mjs production",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test:browser": "node tests/browser/run.mjs",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "html",
    "preview"
  ],
  "author": "Robin Tan",
  "license": "MIT",
  "dependencies": {
    "postcss": "^8.5.31",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.24",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "obsidian": "latest",
    "playwright": "^1.64.1",
    "ts-jest": "^29.4.15",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
